<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>

<material name="white">
    <color rgba=" 1 1 1 1"/>
</material>

<material name="yellow">
    <color rgba=" 0.9 0.9 0.12 1"/>
</material>
    
    <link name="base_link">
    </link>

    <!-- CHASSIS -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="-0.36 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0.18 0 0.1125" rpy="0 0 0"/>
            <geometry>
                <box size="0.375 0.14 0.225"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0.18 0 0.1125" rpy="0 0 0"/>
            <geometry>
                <box size="0.375 0.14 0.225"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="2.23" x="0.375" y="0.14" z="0.225">
            <origin xyz="0.18 0 0.1125" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- WHEELS -->
    <xacro:macro name="front_wheel" params="side y_offset">

        <joint name="${side}_steering_joint" type="revolute">
            <parent link="base_link"/>
            <child link="${side}_steering_link"/>
            <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit effort="10" lower="-0.524" upper="0.524" velocity="0.5"/>
            <xacro:if value="${side=='RF'}">
                <mimic joint="LF_steering_joint" multiplier="1" offset="0"/>
            </xacro:if>
        </joint>

        <joint name="${side}_wheel_joint" type="continuous">
            <parent link="${side}_steering_link"/>
            <child link="${side}_wheel"/>
            <origin xyz="0 0 0" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
            <limit effort="0.05" velocity="10.0"/>
        </joint>

        <link name="${side}_steering_link">
            <inertial>
                <mass value="0.01"/>
                <inertia ixx="0.000001" ixy="0" ixz="0"
                        iyy="0.000001" iyz="0"
                        izz="0.000001"/>
            </inertial>
        </link>

        <link name="${side}_wheel">
            <visual>
                <geometry>
                    <cylinder length="0.03" radius="0.0425"/>
                </geometry>
                <material name="yellow"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="0.0425"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.55" length="0.03" radius="0.0425">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

    </xacro:macro>

    <xacro:macro name="rear_wheel" params="side y_offset">

        <joint name="${side}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${side}_wheel"/>
            <origin xyz="-0.36 ${y_offset} 0" rpy="-${pi/2} 0 0"/>
            <axis xyz="0 0 1"/>
            <limit effort="0.05" velocity="10.0"/>
        </joint>

        <link name="${side}_wheel">
            <visual>
                <geometry>
                    <cylinder length="0.03" radius="0.0425"/>
                </geometry>
                <material name="yellow"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="0.0425"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.55" length="0.03" radius="0.0425">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

    </xacro:macro>

    <xacro:front_wheel side="LF" y_offset="0.095"/>
    <xacro:front_wheel side="RF" y_offset="-0.095"/>
    <xacro:rear_wheel side="LR" y_offset="0.095"/>
    <xacro:rear_wheel side="RR" y_offset="-0.095"/>   

</robot>